# ============================================================
# refactory Configuration
# ============================================================

# GitHub App ID (required)
# Reuse the same App as Fixooly so clone tokens work on the same orgs.
REFACTORY_APP_ID=

# GitHub App Private Key (one of these is required)
REFACTORY_PRIVATE_KEY_PATH=
# REFACTORY_PRIVATE_KEY=

# Classic PAT as Senna46 (required)
# Used to create pull requests (author must be Senna46 for Bugbot)
# and to push branches so GitHub webhooks fire.
# Create at: https://github.com/settings/tokens (classic, repo scope)
REFACTORY_GITHUB_TOKEN=

# GitHub login that will author the PRs (default: Senna46)
REFACTORY_AUTHOR_LOGIN=Senna46

# Comma-separated owner/name list (required for a useful run)
# Default: d6e-ai/d6e,d6e-ai/d6e-auth,d6e-ai/ai-gateway,d6e-products/d6e-valuation,d6e-products/ai-keiri
REFACTORY_REPOS=d6e-ai/d6e,d6e-ai/d6e-auth,d6e-ai/ai-gateway,d6e-products/d6e-valuation,d6e-products/ai-keiri

# Working directory for cloned repos (default: ~/.refactory/repos)
REFACTORY_WORK_DIR=

# SQLite database path (default: ~/.refactory/state.db)
REFACTORY_DB_PATH=

# Claude model override (optional)
REFACTORY_CLAUDE_MODEL=

# Claude -p timeout in seconds (default: 2700 = 45 minutes)
REFACTORY_CLAUDE_TIMEOUT=2700

# Log level: debug, info, warn, error (default: info)
REFACTORY_LOG_LEVEL=info

# Set to 1 to ignore the Sunday-cycle skip (same as passing --force)
# REFACTORY_FORCE=1

# ============================================================
# AI Authentication
# ============================================================

# Claude Code OAuth token (required on headless / launchd runs)
# Generate with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Or use Anthropic API key for pay-as-you-go
ANTHROPIC_API_KEY=
